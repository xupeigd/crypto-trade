{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,           // 放宽: 不检查未使用的局部变量
    "noUnusedParameters": false,       // 放宽: 不检查未使用的参数
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/__dev__"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
