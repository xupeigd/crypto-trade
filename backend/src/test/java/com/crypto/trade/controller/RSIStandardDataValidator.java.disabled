    /**
     * 手动验证RSI计算步骤
     */
    public static void manualRSIVerification() {
        logger.info("开始手动RSI计算验证...");

        // 使用简单数据集手动验证计算步骤
        List<Double> prices = List.of(100.0, 101.0, 102.0, 103.0, 104.0);
        int period = 4;

        logger.info("手动验证数据: {}", prices);
        logger.info("RSI周期: {}", period);

        // 计算价格变动
        List<Double> gains = new ArrayList<>();
        List<Double> losses = new ArrayList<>();

        for (int i = 1; i < prices.size(); i++) {
            double change = prices.get(i) - prices.get(i - 1);
            if (change > 0) {
                gains.add(change);
                losses.add(0.0);
            } else {
                gains.add(0.0);
                losses.add(-change);
            }
        }

        logger.info("价格变动: gains={}, losses={}", gains, losses);

        // 计算初始平均值（简单移动平均）
        double avgGain = gains.stream().limit(period).mapToDouble(Double::doubleValue).average().orElse(0.0);
        double avgLoss = losses.stream().limit(period).mapToDouble(Double::doubleValue).average().orElse(0.0);

        logger.info("初始平均: avgGain={:.4f}, avgLoss={:.4f}", avgGain, avgLoss);

        // 计算第一个RSI值
        double rs = avgLoss > 0 ? avgGain / avgLoss : 0;
        double firstRSI = avgLoss <= 1e-10 ? 100.0 : 100.0 - (100.0 / (1.0 + rs));

        logger.info("第一个RSI: RS={:.4f}, RSI={:.2f}", rs, firstRSI);

        // 验证第一个RSI值
        double expectedFirstRSI = 70.59; // 手动计算结果
        double error = Math.abs(firstRSI - expectedFirstRSI);

        logger.info("预期第一个RSI: {:.2f}, 实际: {:.2f}, 误差: {:.2f}",
                expectedFirstRSI, firstRSI, error);

        if (error <= 0.1) {
            logger.info("✓ 手动RSI计算验证通过");
        } else {
            logger.error("✗ 手动RSI计算验证失败 - 误差过大");
        }
    }

